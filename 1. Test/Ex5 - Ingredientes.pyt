#Datos iniciales
comensales = int(input("Indique la cantidad de persones para la tortilla de patatas: "))
print("--------------------------------------------")

#Calculo
patatas = float(comensales*0.2)
huevos = float(patatas*5)
cebolla = float(patatas*0.3)

#Resultado
print("La cantidad de ingredientes requeridos es la siguiente:")
print("--------------------------------------------")
print("Patatas:",patatas," kilo/s")
print("Huevos:",huevos," unidades")
print("Cebolla:",cebolla," kilos")
print("--------------------------------------------")