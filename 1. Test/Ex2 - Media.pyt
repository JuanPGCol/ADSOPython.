#Datos
num1 = int(input("Indique el primer digito: "))
num2 = int(input("Indique el segundo digito: "))
num3 = int(input("Indique el tercer digito: "))

#Calculo de la media
media = (num1+num2+num3)/3

#Datos finales
print("----------------------------------------")
print("La media entre los 3 digitos indicados (",num1,";",num2,";",num3,") es: ",media,)
print("----------------------------------------")